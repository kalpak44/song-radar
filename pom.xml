<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.kalpak44</groupId>
    <artifactId>song-radar</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>SongRadar</name>
    <description>Self-hosted music discovery from IPTV and radio streams</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <node.version>v24.14.0</node.version>
        <npm.version>11.9.0</npm.version>

        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
        <fmt.plugin.version>2.29</fmt.plugin.version>
        <jacoco.plugin.version>0.8.15</jacoco.plugin.version>
        <sonar.plugin.version>5.8.0.7211</sonar.plugin.version>
        <jib.plugin.version>3.5.2</jib.plugin.version>
        <download.plugin.version>1.10.0</download.plugin.version>

        <!-- Bundled into the image by jib below. yt-dlp needs the musl build, not the
             usual yt-dlp_linux: the base image is Alpine and the glibc binary will not
             start there. ffmpeg is not optional company for it — the YouTube source runs
             yt-dlp with audio extraction, which is ffmpeg's job, so a yt-dlp shipped on
             its own downloads the audio and then fails to convert it. Both are amd64,
             matching the platform jib builds for. Checksums are the ones the publishers
             state; a changed version needs its checksum changed with it or the build
             stops. -->
        <ytdlp.version>2026.10.21</ytdlp.version>
        <ytdlp.sha256>d39487ff5c8eb1254d6f142bea05f495440d87ff529b2df786dcd3b5f66b23a8</ytdlp.sha256>
        <!-- A fully static musl build, so it starts on the Alpine base image; the
             glibc-linked builds from BtbN and Jellyfin do not. The publisher ships one
             binary per release rather than a tarball, so the build still needs no
             unpacking step. ffprobe is deliberately not bundled: it would add another
             90 MB and audio extraction was verified to work without it. -->
        <ffmpeg.version>9.0.2</ffmpeg.version>
        <ffmpeg.release>v9.0.2-12Oct26-c3e6b6071ce0</ffmpeg.release>
        <ffmpeg.asset>ffmpeg-9.0.2-20261012-amd64</ffmpeg.asset>
        <ffmpeg.sha256>0cbf5e656a2cf2e6f4f265f4a784e97f3812fcfd805599264ca3ab42956807be</ffmpeg.sha256>

        <!-- The source checks reach the real music catalogues, so they are held out of the
             normal build and run on their own schedule. -->
        <excluded.test.groups>live</excluded.test.groups>

        <sonar.projectKey>song-radar</sonar.projectKey>
        <sonar.organization>kalpak44</sonar.organization>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <!-- starter-web is deprecated in Boot 4; webmvc is the supported name. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Data JDBC never creates tables, so the schema is Flyway's.
             Three artifacts, each needed: spring-boot-flyway carries the
             auto-configuration, which Boot 4 moved out of the main jar — without it
             flyway-core sits on the classpath and silently never runs; and the
             postgresql module is separate from Flyway 10 onward. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Version comes from the Boot BOM, so a Boot upgrade moves the driver with it. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Decodes the AAC a music source serves so the transcoder can re-encode it. It does
             not decode recordings: it answers frames it cannot handle with a buffer of zeros and
             no error, which is silence no check on the file can see, and ffmpeg decodes those
             instead. Measured blanking rises as the bitrate falls — 0.4% at 320 kbps, 7.9% at
             160 kbps — so the AAC paths below are ranked under the ones that need no decode.
             See docs/recording.md. -->
        <dependency>
            <groupId>com.gitlab.9lukas5</groupId>
            <artifactId>jaad</artifactId>
            <version>0.8.8</version>
        </dependency>

        <!-- Pure-Java LAME. Library downloads arrive as AAC and the image carries no
             ffmpeg, so the encode has to happen in this process. -->
        <dependency>
            <groupId>de.sciss</groupId>
            <artifactId>jump3r</artifactId>
            <version>1.0.5</version>
        </dependency>

        <!-- Writes the ID3 tags on a downloaded track. -->
        <dependency>
            <groupId>com.mpatric</groupId>
            <artifactId>mp3agic</artifactId>
            <version>0.9.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 moved @WebMvcTest out of starter-test into its own artifact. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- A catalogue being unreachable must never fail a pull request; the scheduled
                 source check clears this group with -Dexcluded.test.groups=. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excluded.test.groups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- The pom declares Java 25 but the compiler only needs a 25 bytecode
                 target, which an older JDK can be asked for and then fail on a 25
                 language feature. Fail on the JDK itself instead. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- google-java-format, with no style settings to argue about. `fmt:check`
                 is the CI gate; `fmt:format` is what fixes a failure. -->
            <plugin>
                <groupId>com.spotify.fmt</groupId>
                <artifactId>fmt-maven-plugin</artifactId>
                <version>${fmt.plugin.version}</version>
            </plugin>

            <!-- Produces the XML report Sonar reads for coverage. No check rule yet:
                 a floor set against a single test is one that stays low. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.plugin.version}</version>
            </plugin>

            <!-- Builds the container image from target/classes with no Dockerfile, which
                 is why dependabot.yml has no `docker` entry: the base image is pinned
                 here and moves as a Maven property. -->
            <!-- Fetches the two binaries the image ships. Bound to prepare-package so a
                 plain `mvn test` does not pull 120 MB, and cached under ~/.m2 so CI pulls
                 them once rather than once per run. -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>${download.plugin.version}</version>
                <executions>
                    <execution>
                        <id>fetch-yt-dlp</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <uri>https://github.com/yt-dlp/yt-dlp/releases/download/${ytdlp.version}/yt-dlp_musllinux</uri>
                            <outputDirectory>${project.build.directory}/jib-extra/usr/local/bin</outputDirectory>
                            <outputFileName>yt-dlp</outputFileName>
                            <sha256>${ytdlp.sha256}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fetch-ffmpeg</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <uri>https://github.com/start-the-fire/ffmpeg-musl-forge/releases/download/${ffmpeg.release}/${ffmpeg.asset}</uri>
                            <outputDirectory>${project.build.directory}/jib-extra/usr/local/bin</outputDirectory>
                            <outputFileName>ffmpeg</outputFileName>
                            <sha256>${ffmpeg.sha256}</sha256>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- The scanner's ffmpeg classifier matches the literal format string
                 "%s version <version>" inside a file named ffmpeg. FFmpeg 9 builds that
                 string at runtime, so the binary alone is no longer recognised and the
                 scan would silently stop seeing the bundled ffmpeg. Generate the metadata
                 file the classifier needs from the same property that pins the binary;
                 it is never executed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ffmpeg-scan-metadata</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jib-extra/usr/local/share/song-radar</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/jib-metadata</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>${jib.plugin.version}</version>
                <configuration>
                    <from>
                        <!-- Rebuilt by its publisher after the current Alpine security
                             updates. The Temurin JRE image on the same Alpine release
                             lags those rebuilds, and the scan reports the difference as
                             fixable Critical findings in OpenSSL and expat. -->
                        <image>azul/zulu-openjdk-alpine:25-jre-headless</image>
                        <!-- Stated rather than inherited: the yt-dlp and ffmpeg binaries
                             below are amd64, so a build for another architecture would
                             produce an image whose YouTube source cannot start. -->
                        <platforms>
                            <platform>
                                <architecture>amd64</architecture>
                                <os>linux</os>
                            </platform>
                        </platforms>
                    </from>
                    <!-- /usr/local/bin is already on PATH, so yt-dlp finds ffmpeg and the
                         application finds yt-dlp under its default configuration. The
                         files are put there by download-maven-plugin at prepare-package;
                         `mvn package` is what fills this directory. -->
                    <extraDirectories>
                        <paths>
                            <path>
                                <from>${project.build.directory}/jib-extra</from>
                                <into>/</into>
                            </path>
                        </paths>
                        <permissions>
                            <permission>
                                <file>/usr/local/bin/yt-dlp</file>
                                <mode>755</mode>
                            </permission>
                            <permission>
                                <file>/usr/local/bin/ffmpeg</file>
                                <mode>755</mode>
                            </permission>
                        </permissions>
                    </extraDirectories>
                    <container>
                        <mainClass>io.github.kalpak44.songradar.SongRadarApplication</mainClass>
                        <ports>
                            <port>8080</port>
                        </ports>
                        <!-- jib declares no USER by default, and a Deployment that sets
                             runAsNonRoot against such an image is refused by the kubelet
                             at startup rather than at apply time. -->
                        <user>1000:1000</user>
                        <!-- Without this every build produces the same 1970 timestamp, so
                             `docker images` cannot tell a fresh image from a stale one. -->
                        <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                        <!-- Links the published package back to this repository; without
                             it the registry page lists no source. -->
                        <labels>
                            <org.opencontainers.image.source>https://github.com/kalpak44/song-radar</org.opencontainers.image.source>
                        </labels>
                    </container>
                </configuration>
            </plugin>

            <!-- Builds the Tailwind stylesheet as part of the Maven build, so a plain
                 `./mvnw spring-boot:run` on a fresh clone serves styled pages with no
                 separate npm step. Node is downloaded into the project, not required
                 on the machine. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <!-- Runs before process-resources so the generated stylesheet is in
                         target/classes before the jar is assembled. -->
                    <execution>
                        <id>tailwind-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build:css</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
