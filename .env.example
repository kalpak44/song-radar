# Copy to .env and fill in, then export it before `./mvnw spring-boot:run`:
#   set -a && source .env && set +a

SONGRADAR_DB_HOST=localhost
SONGRADAR_DB_PORT=5432
SONGRADAR_DB_NAME=songradar
SONGRADAR_DB_USERNAME=songradar
# No default in application.yml — the application will not start without this.
SONGRADAR_DB_PASSWORD=songradar

SONGRADAR_PORT=8080

# Re-renders templates on every request. Leave unset in anything but local development.
SONGRADAR_TEMPLATE_CACHE=false

# Writable SongRadar volume. Playlist uploads and listener recordings live below it.
# Set this to /data in the cluster.
SONGRADAR_STORAGE_PATH=./data
# Optional logical volume capacity. Zero reads capacity from the local filesystem.
SONGRADAR_STORAGE_CAPACITY_GB=0

# Concurrent recording workers. A single listener still never records concurrently.
SONGRADAR_LISTENER_THREADS=2
SONGRADAR_RECOGNITION_THREADS=1

# Optional: enables automatic track identification for new recordings.
SONGRADAR_AUDD_API_TOKEN=
