# Maven
target/
# The wrapper itself is committed; only its downloaded distribution is not.
.mvn/wrapper/maven-wrapper.jar

# Node — the Tailwind build downloads its own copy of node into the project.
node_modules/
node/

# Environment — .env holds real credentials; .env.example is the committed template.
.env

# Local uploads — the cluster keeps these on a volume.
/data/

# Logs
*.log

# JVM crash logs
hs_err_pid*
replay_pid*

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS
.DS_Store
